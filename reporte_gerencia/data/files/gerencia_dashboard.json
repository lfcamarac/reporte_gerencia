{
  "version": 16,
  "sheets": [
    {
      "id": "sheet1",
      "name": "Resumen Ejecutivo",
      "cells": {
        "A1": { "content": "TABLERO GERENCIAL CONSOLIDADO", "style": { "bold": true, "fontSize": 14 } },
        "A3": { "content": "VENTAS Y RENTABILIDAD", "style": { "bold": true } },
        "A4": { "content": "Ventas Totales ($)", "style": { "fillColor": "#f2f2f2", "bold": true } },
        "A5": { "content": "=PIVOT.VALUE(1, 'price_total_usd')", "format": "#,##0.00" },
        "B4": { "content": "Costo de Ventas ($)", "style": { "fillColor": "#f2f2f2", "bold": true } },
        "B5": { "content": "=PIVOT.VALUE(1, 'cost_total_usd')", "format": "#,##0.00" },
        "C4": { "content": "Utilidad Bruta ($)", "style": { "fillColor": "#f2f2f2", "bold": true } },
        "C5": { "content": "=PIVOT.VALUE(1, 'margin_usd')", "format": "#,##0.00" },
        "D4": { "content": "Margen %", "style": { "fillColor": "#f2f2f2", "bold": true } },
        "D5": { "content": "=IF(A5>0, C5/A5, 0)", "format": "0.00%" },
        "E4": { "content": "Ticket Promedio ($)", "style": { "fillColor": "#f2f2f2", "bold": true } },
        "E5": { "content": "=IF(PIVOT.VALUE(1, 'order_count')>0, A5/PIVOT.VALUE(1, 'order_count'), 0)", "format": "#,##0.00" },
        
        "A7": { "content": "VENTAS POR CATEGORÍA", "style": { "bold": true } },
        "A8": { "content": "=PIVOT.HEADER(1, 'main_categ_name')", "style": { "bold": true } },
        "B8": { "content": "Venta ($)", "style": { "bold": true } },
        "C8": { "content": "Utilidad ($)", "style": { "bold": true } },
        "A9": { "content": "=PIVOT.HEADER(1, 'main_categ_name', 1)" },
        "B9": { "content": "=PIVOT.VALUE(1, 'price_total_usd', 'main_categ_name', 1)", "format": "#,##0.00" },
        "C9": { "content": "=PIVOT.VALUE(1, 'margin_usd', 'main_categ_name', 1)", "format": "#,##0.00" },
        
        "E7": { "content": "TOP 10 PROVEEDORES", "style": { "bold": true } },
        "E8": { "content": "Proveedor", "style": { "bold": true } },
        "F8": { "content": "Compras ($)", "style": { "bold": true } },
        "E9": { "content": "=PIVOT.HEADER(2, 'partner_id', 1)" },
        "F9": { "content": "=PIVOT.VALUE(2, 'price_total_usd', 'partner_id', 1)", "format": "#,##0.00" },

        "A15": { "content": "FINANZAS (CxC / CxP)", "style": { "bold": true } },
        "A16": { "content": "Indicador", "style": { "bold": true } },
        "B16": { "content": "Monto ($)", "style": { "bold": true } },
        "A17": { "content": "Total Cuentas por Cobrar" },
        "B17": { "content": "=ABS(PIVOT.VALUE(3, 'balance_usd', 'account_type', 'asset_receivable'))", "format": "#,##0.00" },
        "A18": { "content": "Total Cuentas por Pagar" },
        "B18": { "content": "=ABS(PIVOT.VALUE(3, 'balance_usd', 'account_type', 'liability_payable'))", "format": "#,##0.00" },

        "E15": { "content": "INVENTARIO ABC (Inversión)", "style": { "bold": true } },
        "E16": { "content": "Clasificación", "style": { "bold": true } },
        "F16": { "content": "Valor ($)", "style": { "bold": true } },
        "E17": { "content": "Clase A (Alta Inversión)" },
        "F17": { "content": "=PIVOT.VALUE(4, 'total_value_usd', 'classification', 'A')", "format": "#,##0.00" },
        "E18": { "content": "Clase B (Media Inversión)" },
        "F18": { "content": "=PIVOT.VALUE(4, 'total_value_usd', 'classification', 'B')", "format": "#,##0.00" },
        "E19": { "content": "Clase C (Baja Inversión)" },
        "F19": { "content": "=PIVOT.VALUE(4, 'total_value_usd', 'classification', 'C')", "format": "#,##0.00" }
      },
      "pivots": {
        "1": {
          "name": "Ventas Consolidadas",
          "model": "reporte.gerencia.ventas",
          "measures": [
            { "field": "price_total_usd", "operator": "sum" },
            { "field": "cost_total_usd", "operator": "sum" },
            { "field": "margin_usd", "operator": "sum" },
            { "field": "order_count", "operator": "sum" }
          ],
          "rowGroupBys": [{ "field": "main_categ_name" }],
          "colGroupBys": [],
          "domain": []
        },
        "2": {
          "name": "Ranking Proveedores",
          "model": "reporte.gerencia.compras",
          "measures": [{ "field": "price_total_usd", "operator": "sum" }],
          "rowGroupBys": [{ "field": "partner_id" }],
          "colGroupBys": [],
          "domain": []
        },
        "3": {
          "name": "CxC y CxP",
          "model": "reporte.gerencia.financiero",
          "measures": [{ "field": "balance_usd", "operator": "sum" }],
          "rowGroupBys": [{ "field": "partner_id" }],
          "colGroupBys": [{ "field": "account_type" }],
          "domain": []
        },
        "4": {
          "name": "Inventario ABC",
          "model": "reporte.gerencia.inventario.abc",
          "measures": [{ "field": "total_value_usd", "operator": "sum" }],
          "rowGroupBys": [{ "field": "classification" }],
          "colGroupBys": [],
          "domain": []
        }
      }
    }
  ],
  "entities": {
    "odoo": {
      "globalFilters": [
        {
          "id": "periodo",
          "type": "date",
          "label": "Periodo",
          "defaultValue": "this_month",
          "rangeType": "relative"
        }
      ]
    }
  }
}
