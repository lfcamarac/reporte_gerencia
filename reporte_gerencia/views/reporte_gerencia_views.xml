<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VENTAS -->
    <record id="view_reporte_gerencia_ventas_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.pivot</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Ventas Consolidadas" sample="1">
                <field name="main_categ_name" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="price_total_usd" type="measure"/>
                <field name="margin_usd" type="measure"/>
                <field name="order_count" type="measure" string="Nro Pedidos"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_ventas_graph" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.graph</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <graph string="Ventas por Categoría Principal" type="bar" sample="1">
                <field name="main_categ_name"/>
                <field name="price_total_usd" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_reporte_gerencia_ventas_tree" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.tree</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <list string="Auditoría de Ventas" decoration-success="margin_usd > 0" decoration-danger="margin_usd &lt; 0">
                <field name="date"/>
                <field name="order_ref"/>
                <field name="source" widget="badge" decoration-info="source == 'pos'" decoration-success="source == 'sale'" decoration-warning="source == 'invoice'"/>
                <field name="main_categ_name"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Cantidad"/>
                <field name="price_total" sum="Total Bs" optional="hide"/>
                <field name="price_total_usd" sum="Total $" widget="monetary"/>
                <field name="cost_total_usd" sum="Total Costo $" optional="show"/>
                <field name="margin_usd" sum="Total Utilidad $" widget="monetary"/>
                <field name="order_count" sum="Total Pedidos" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_reporte_gerencia_ventas_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.search</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="main_categ_name"/>
                <field name="order_ref"/>
                <filter string="Ventas POS" name="pos" domain="[('source', '=', 'pos')]"/>
                <filter string="Ventas Oficina" name="sale" domain="[('source', '=', 'sale')]"/>
                <filter string="Facturas Directas" name="invoice" domain="[('source', '=', 'invoice')]"/>
                <separator/>
                <filter string="Ventas con Utilidad" name="profit" domain="[('margin_usd', '>', 0)]"/>
                <filter string="Ventas a Pérdida" name="loss" domain="[('margin_usd', '&lt;', 0)]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')), ('date', '&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Este Mes" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Mes Pasado" name="last_month" domain="[('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), ('date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="date"/>
                <separator/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Categoría Principal" name="group_main_categ" context="{'group_by': 'main_categ_name'}"/>
                    <filter string="Origen / Canal" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Día" name="group_date_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Semana" name="group_date_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Mes" name="group_date_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_ventas" model="ir.actions.act_window">
        <field name="name">Análisis de Ventas Consolidadas</field>
        <field name="res_model">reporte.gerencia.ventas</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_reporte_gerencia_ventas_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_main_categ': 1}</field>
    </record>

    <!-- COMPRAS -->
    <record id="view_reporte_gerencia_compras_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.pivot</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Compras" sample="1">
                <field name="partner_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="price_total_usd" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_compras_graph" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.graph</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <graph string="Ranking de Proveedores" type="bar" sample="1" order="DESC">
                <field name="partner_id"/>
                <field name="price_total_usd" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_reporte_gerencia_compras_tree" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.tree</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <list string="Auditoría de Compras">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="main_categ_name"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Unidades"/>
                <field name="price_total" sum="Total Bs" optional="hide"/>
                <field name="price_total_usd" sum="Total $" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_reporte_gerencia_compras_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.search</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="main_categ_name"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Este Mes" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Mes Pasado" name="last_month" domain="[('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')), ('date', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="date"/>
                <separator/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Categoría Principal" name="group_main_categ" context="{'group_by': 'main_categ_name'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Mes" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_compras" model="ir.actions.act_window">
        <field name="name">Ranking de Proveedores</field>
        <field name="res_model">reporte.gerencia.compras</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_partner': 1}</field>
    </record>

    <!-- FINANZAS (CxC / CxP) -->
    <record id="view_reporte_gerencia_financiero_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.financiero.pivot</field>
        <field name="model">reporte.gerencia.financiero</field>
        <field name="arch" type="xml">
            <pivot string="Análisis CxC y CxP" sample="1">
                <field name="partner_id" type="row"/>
                <field name="account_type" type="col"/>
                <field name="invoiced_amount_usd" type="measure"/>
                <field name="paid_amount_usd" type="measure"/>
                <field name="balance_usd" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_financiero_tree" model="ir.ui.view">
        <field name="name">reporte.gerencia.financiero.tree</field>
        <field name="model">reporte.gerencia.financiero</field>
        <field name="arch" type="xml">
            <list string="Detalle de Movimientos CxC / CxP" decoration-info="account_type == 'asset_receivable'" decoration-warning="account_type == 'liability_payable'">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="account_type" widget="badge" decoration-info="account_type == 'asset_receivable'" decoration-warning="account_type == 'liability_payable'"/>
                <field name="invoiced_amount_usd" sum="Total Facturado $" widget="monetary"/>
                <field name="paid_amount_usd" sum="Total Pagado $" widget="monetary"/>
                <field name="balance_usd" sum="Saldo Total $" widget="monetary" decoration-danger="balance_usd != 0"/>
            </list>
        </field>
    </record>

    <record id="view_reporte_gerencia_financiero_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.financiero.search</field>
        <field name="model">reporte.gerencia.financiero</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_type"/>
                <filter string="Cuentas por Cobrar" name="receivable" domain="[('account_type', '=', 'asset_receivable')]"/>
                <filter string="Cuentas por Pagar" name="payable" domain="[('account_type', '=', 'liability_payable')]"/>
                <separator/>
                <filter string="Solo con Saldo Pendiente" name="with_value" domain="[('balance_usd', '!=', 0)]"/>
                <separator/>
                <filter string="Fecha" name="filter_date" date="date"/>
                <separator/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Contacto" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Tipo de Cuenta" name="group_type" context="{'group_by': 'account_type'}"/>
                    <filter string="Mes" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_financiero" model="ir.actions.act_window">
        <field name="name">Estado de CxC y CxP</field>
        <field name="res_model">reporte.gerencia.financiero</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_with_value': 1, 'search_default_group_partner': 1}</field>
    </record>

    <!-- INVENTARIO ABC -->
    <record id="view_reporte_gerencia_inventario_abc_tree" model="ir.ui.view">
        <field name="name">reporte.gerencia.inventario.abc.tree</field>
        <field name="model">reporte.gerencia.inventario.abc</field>
        <field name="arch" type="xml">
            <list string="Clasificación ABC de Inventario" decoration-danger="classification == 'C'" decoration-warning="classification == 'B'" decoration-success="classification == 'A'">
                <field name="product_id"/>
                <field name="main_categ_name"/>
                <field name="categ_id" optional="hide"/>
                <field name="stock" sum="Total Existencia"/>
                <field name="cost_usd" string="Costo Unit. ($)"/>
                <field name="total_value_usd" string="Valor Total ($)" sum="Inversión Total"/>
                <field name="cumulative_percentage" widget="progressbar"/>
                <field name="classification" widget="badge" decoration-success="classification == 'A'" decoration-warning="classification == 'B'" decoration-danger="classification == 'C'"/>
            </list>
        </field>
    </record>

    <record id="view_reporte_gerencia_inventario_abc_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.inventario.abc.pivot</field>
        <field name="model">reporte.gerencia.inventario.abc</field>
        <field name="arch" type="xml">
            <pivot string="Resumen de Inversión ABC" sample="1">
                <field name="classification" type="row"/>
                <field name="main_categ_name" type="row"/>
                <field name="total_value_usd" type="measure" string="Valor Total ($)"/>
                <field name="stock" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_inventario_abc_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.inventario.abc.search</field>
        <field name="model">reporte.gerencia.inventario.abc</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="main_categ_name"/>
                <field name="categ_id"/>
                <filter string="Con Existencia" name="with_stock" domain="[('stock', '>', 0)]"/>
                <filter string="Sin Existencia" name="no_stock" domain="[('stock', '&lt;=', 0)]"/>
                <separator/>
                <filter string="Alta Inversión (A)" name="class_a" domain="[('classification', '=', 'A')]"/>
                <filter string="Media Inversión (B)" name="class_b" domain="[('classification', '=', 'B')]"/>
                <filter string="Baja Inversión (C)" name="class_c" domain="[('classification', '=', 'C')]"/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Clasificación ABC" name="group_class" context="{'group_by': 'classification'}"/>
                    <filter string="Categoría Principal" name="group_main_categ" context="{'group_by': 'main_categ_name'}"/>
                    <filter string="Categoría Específica" name="group_categ" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_inventario_abc" model="ir.actions.act_window">
        <field name="name">Clasificación ABC de Inventario</field>
        <field name="res_model">reporte.gerencia.inventario.abc</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_with_stock': 1, 'search_default_group_class': 1}</field>
    </record>

    <!-- MENÚS -->
    <menuitem id="menu_reporte_gerencia_root" 
              name="Gerencia" 
              sequence="1" 
              web_icon="base,static/description/icon.png"
              groups="group_gerencia_manager"/>

    <menuitem id="menu_reporte_gerencia_ventas" 
              name="Ventas Consolidadas" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_ventas" 
              sequence="10"/>

    <menuitem id="menu_reporte_gerencia_compras" 
              name="Compras / Proveedores" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_compras" 
              sequence="20"/>

    <menuitem id="menu_reporte_gerencia_financiero" 
              name="CxC y CxP" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_financiero" 
              sequence="30"/>

    <menuitem id="menu_reporte_gerencia_inventario_abc" 
              name="Inventario ABC" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_inventario_abc" 
              sequence="40"/>
</odoo>
