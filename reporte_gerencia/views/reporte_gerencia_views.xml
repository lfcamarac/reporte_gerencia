<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reporte_gerencia_ventas_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.pivot</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Ventas Consolidadas">
                <field name="main_categ_name" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="price_total_usd" type="measure"/>
                <field name="margin_usd" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_ventas_graph" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.graph</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <graph string="Ventas por Categoría Principal" type="bar" sample="1">
                <field name="main_categ_name"/>
                <field name="price_total_usd" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_reporte_gerencia_ventas_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.ventas.search</field>
        <field name="model">reporte.gerencia.ventas</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="main_categ_name"/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Categoría Principal" name="group_main_categ" context="{'group_by': 'main_categ_name'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_ventas" model="ir.actions.act_window">
        <field name="name">Análisis de Ventas Consolidadas</field>
        <field name="res_model">reporte.gerencia.ventas</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_group_main_categ': 1}</field>
    </record>

    <record id="view_reporte_gerencia_compras_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.pivot</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Compras">
                <field name="partner_id" type="row"/>
                <field name="price_total_usd" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_compras_graph" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.graph</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <graph string="Ranking de Proveedores" type="bar" sample="1" order="DESC">
                <field name="partner_id"/>
                <field name="price_total_usd" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_reporte_gerencia_compras_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.compras.search</field>
        <field name="model">reporte.gerencia.compras</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="main_categ_name"/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Categoría Principal" name="group_main_categ" context="{'group_by': 'main_categ_name'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_compras" model="ir.actions.act_window">
        <field name="name">Ranking de Proveedores</field>
        <field name="res_model">reporte.gerencia.compras</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <!-- Reporte Financiero (CxC / CxP) -->
    <record id="view_reporte_gerencia_financiero_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.financiero.pivot</field>
        <field name="model">reporte.gerencia.financiero</field>
        <field name="arch" type="xml">
            <pivot string="Análisis CxC y CxP">
                <field name="partner_id" type="row"/>
                <field name="account_type" type="col"/>
                <field name="invoiced_amount_usd" type="measure"/>
                <field name="paid_amount_usd" type="measure"/>
                <field name="balance_usd" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reporte_gerencia_financiero_search" model="ir.ui.view">
        <field name="name">reporte.gerencia.financiero.search</field>
        <field name="model">reporte.gerencia.financiero</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_type"/>
                <filter string="Cuentas por Cobrar" name="receivable" domain="[('account_type', '=', 'asset_receivable')]"/>
                <filter string="Cuentas por Pagar" name="payable" domain="[('account_type', '=', 'liability_payable')]"/>
                <group expand="1" string="Agrupar Por">
                    <filter string="Contacto" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Tipo" name="group_type" context="{'group_by': 'account_type'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_gerencia_financiero" model="ir.actions.act_window">
        <field name="name">Estado de CxC y CxP</field>
        <field name="res_model">reporte.gerencia.financiero</field>
        <field name="view_mode">pivot</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>

    <!-- Inventario ABC -->
    <record id="view_reporte_gerencia_inventario_abc_tree" model="ir.ui.view">
        <field name="name">reporte.gerencia.inventario.abc.tree</field>
        <field name="model">reporte.gerencia.inventario.abc</field>
        <field name="arch" type="xml">
            <list string="Clasificación ABC" decoration-danger="classification == 'C'" decoration-warning="classification == 'B'" decoration-success="classification == 'A'">
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="stock"/>
                <field name="cost_usd" string="Costo ($)"/>
                <field name="total_value_usd" string="Valor ($)" sum="Total"/>
                <field name="cumulative_percentage" widget="progressbar"/>
                <field name="classification" widget="badge" decoration-success="classification == 'A'" decoration-warning="classification == 'B'" decoration-danger="classification == 'C'"/>
            </list>
        </field>
    </record>

    <record id="view_reporte_gerencia_inventario_abc_pivot" model="ir.ui.view">
        <field name="name">reporte.gerencia.inventario.abc.pivot</field>
        <field name="model">reporte.gerencia.inventario.abc</field>
        <field name="arch" type="xml">
            <pivot string="Resumen ABC">
                <field name="classification" type="row"/>
                <field name="total_value_usd" type="measure" string="Valor Total ($)"/>
            </pivot>
        </field>
    </record>

    <record id="action_reporte_gerencia_inventario_abc" model="ir.actions.act_window">
        <field name="name">Clasificación ABC de Inventario</field>
        <field name="res_model">reporte.gerencia.inventario.abc</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_reporte_gerencia_root" 
              name="Gerencia" 
              sequence="1" 
              web_icon="base,static/description/icon.png"
              groups="group_gerencia_manager"/>

    <menuitem id="menu_reporte_gerencia_ventas" 
              name="Ventas Consolidadas" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_ventas" 
              sequence="10"/>

    <menuitem id="menu_reporte_gerencia_compras" 
              name="Compras / Proveedores" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_compras" 
              sequence="20"/>

    <menuitem id="menu_reporte_gerencia_financiero" 
              name="CxC y CxP" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_financiero" 
              sequence="30"/>

    <menuitem id="menu_reporte_gerencia_inventario_abc" 
              name="Inventario ABC" 
              parent="menu_reporte_gerencia_root" 
              action="action_reporte_gerencia_inventario_abc" 
              sequence="40"/>
</odoo>
